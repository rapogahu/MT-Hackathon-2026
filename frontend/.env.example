# Default and production mode. Fixtures are never an automatic fallback.
VITE_DATA_SOURCE=api
# Production-only external API origin. Empty uses same-origin requests.
VITE_API_BASE_URL=
# Development backend target for the same-origin Vite /api proxy.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Optional MapLibre style URL. Leave empty for the built-in OpenStreetMap raster style.
VITE_MAP_STYLE_URL=

# Development-only fixture scenario: default | empty-runs | error | degenerate | map-error
VITE_FIXTURE_SCENARIO=default
